PORT=3333

# PostgreSQL/Supabase: escolha UM método de conexão e copie host/usuário/porta do painel Connect.
# Conexão direta (host db.<project-ref>.supabase.co): usuário normalmente é postgres.
DB_HOST=db.seu-project-ref.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=coloque-a-senha-original-aqui
# Se usar Session Pooler, substitua HOST/PORT pelos valores do painel e use o usuário postgres.<project-ref>.
# Alternativa em vez das variáveis DB_*: DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres

DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA=C:/caminho/para/ca.crt
# DB_SSL_REJECT_UNAUTHORIZED=false é apenas uma alternativa temporária de desenvolvimento; não recomendado em produção.

# JWT (use um segredo aleatório com pelo menos 32 caracteres)
ACCESS_TOKEN_SECRET=troque-por-um-segredo-aleatorio-com-mais-de-32-caracteres
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# CORS: lista separada por vírgulas, sem barra final
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Cookies. Em produção: Secure=true e SameSite=none
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY=false

# Rate limit
API_RATE_LIMIT=300
AUTH_RATE_LIMIT=10
SALE_RATE_LIMIT=20

# Supabase Storage (somente backend)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHAVE_PRIVILEGIADA_DO_BACKEND
SUPABASE_BUCKET=products
